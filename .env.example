# ═══════════════════════════════════════════════════════════
# LOUBNA ABOUZ MANTA — Variables d'environnement
# Copiez ce fichier en .env.local et remplissez les valeurs
# ═══════════════════════════════════════════════════════════

# URL du site en production
NEXT_PUBLIC_SITE_URL=https://loubna-abouz-manta.fr

# ─── Option 1 : Formspree ───────────────────────────────────
# Créez un compte sur https://formspree.io et obtenez votre ID
NEXT_PUBLIC_FORMSPREE_ID=your_formspree_id

# ─── Option 2 : EmailJS ────────────────────────────────────
# Créez un compte sur https://emailjs.com
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_service_id
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_template_id
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key

# ─── Option 3 : Resend (API Route Next.js) ─────────────────
# Créez un compte sur https://resend.com
RESEND_API_KEY=re_your_resend_api_key
CONTACT_EMAIL_TO=louamjuristeconseil@gmail.com
# Expéditeur (domaine vérifié sur Resend en production, ex. Site <noreply@votredomaine.fr>)
CONTACT_EMAIL_FROM="Loubna Abouz Manta <contact@juriste-droit-du-travail.com>"

# ─── SumUp Paiements ───────────────────────────────────────
# Créez un compte sur https://developer.sumup.com
SUMUP_API_KEY=sup_sk_...
SUMUP_MERCHANT_CODE=MXXXXXXXX
SUMUP_BASE_URL=https://api.sumup.com
SUMUP_CURRENCY=EUR
# Optionnel : secret pour valider les webhooks SumUp
SUMUP_WEBHOOK_SECRET=
NEXT_PUBLIC_PAYMENT_PROVIDER=sumup

# ─── Google Analytics (optionnel) ──────────────────────────
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
