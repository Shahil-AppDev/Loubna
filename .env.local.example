# =============================================
# Configuration locale — .env.local
# Copier ce fichier en .env.local et remplir les valeurs
# Ne jamais committer .env.local dans Git
# =============================================

# --- PostgreSQL Hetzner ---
POSTGRES_HOST=your_hetzner_server_ip
POSTGRES_PORT=5432
POSTGRES_DATABASE=loubna_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password

# --- Session Secret (32+ caractères aléatoires) ---
SESSION_SECRET=change_this_to_a_random_32_character_string_minimum

# --- SumUp Paiements ---
SUMUP_API_KEY=sup_sk_...
SUMUP_MERCHANT_CODE=MXXXXXXXX
SUMUP_BASE_URL=https://api.sumup.com
SUMUP_CURRENCY=EUR
# Optionnel : secret pour valider les webhooks SumUp
SUMUP_WEBHOOK_SECRET=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_PAYMENT_PROVIDER=sumup

# --- Resend — emails transactionnels ---
RESEND_API_KEY=re_...
CONTACT_EMAIL_TO=your@email.com
CONTACT_EMAIL_FROM="Votre Nom <contact@votredomaine.com>"

# --- DEPRECATED (Stripe) ---
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
